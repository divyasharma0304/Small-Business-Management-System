# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Required: the app ---------------------------------------------------------
# Supabase dashboard → Project Settings → API (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# "Publishable" key (sb_publishable_...) — or the legacy "anon" key. Safe for the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Required for `npm run db:push` (applying migrations) -----------------------
# Dashboard → Connect → "Session pooler" connection string, with your database password filled in.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Optional: integration tests only (`npm run test:integration`) -------------
# "Secret" key (sb_secret_...) or legacy "service_role" key. NEVER used by the running app,
# never sent to the browser. Leave empty if you don't run integration tests.
SUPABASE_SERVICE_ROLE_KEY=
